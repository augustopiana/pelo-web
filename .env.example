# Variables de entorno del proyecto. Copiar a .env (no versionado) y ajustar.
# NUNCA versionar credenciales reales (MP, SMTP, BD, JWT).

# ---- Base de datos (docker-compose + backend perfil dev) ----
DB_NAME=vinilos
DB_USER=vinilos
DB_PASSWORD=vinilos
DB_PORT=5432
# URL JDBC que usa el backend (perfil dev arma esta por defecto si no se define)
DB_URL=jdbc:postgresql://localhost:5432/vinilos

# ---- Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# ---- Auth / JWT ----
# En prod es OBLIGATORIO (>= 32 bytes). En dev hay un default no seguro.
# JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32-bytes-o-mas
# Login con Google (scaffold): cargar el Client ID para activarlo.
# GOOGLE_CLIENT_ID=

# ---- Storage de fotos (MinIO en dev, S3-compatible) ----
MINIO_ROOT_USER=peloadmin
MINIO_ROOT_PASSWORD=pelo-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Config del backend (SDK de S3). En prod: endpoint/keys del proveedor real.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pelo-fotos
S3_ACCESS_KEY=peloadmin
S3_SECRET_KEY=pelo-dev-secret

# ---- Email ----
# 'log' (dev, loguea el link de verificacion) | 'smtp' (prod)
APP_MAIL_MODE=log
APP_MAIL_FROM=no-reply@pelo-web.local
# Solo si APP_MAIL_MODE=smtp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Frontend ----
VITE_API_URL=http://localhost:8080
# Client ID de Google (mismo valor que GOOGLE_CLIENT_ID; es público, no secreto).
VITE_GOOGLE_CLIENT_ID=

# ---- Cuentas de prueba (solo perfil dev; las crea el seeder) ----
# admin@pelo-web.local  / admin1234    (ADMIN)
# cliente@pelo-web.local / cliente1234  (CLIENTE, verificado)

# ---- Placeholders para milestones siguientes (pagos, M3) ----
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
