# Copiar a .env.local (no versionado) y ajustar segun el entorno.
# URL base del backend que consume el frontend.
VITE_API_URL=http://localhost:8080

# Client ID de Google para el login con Google (público, no es secreto).
# Debe coincidir con GOOGLE_CLIENT_ID del backend. Vacío = botón deshabilitado.
VITE_GOOGLE_CLIENT_ID=
